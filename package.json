{
  "name": "terrarium-core",
  "packageManager": "pnpm@10.26.2",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "pnpm build:packages && turbo run dev --parallel --filter=!@terrarium/ui-terrain",
    "dev:terrain": "turbo run dev --filter=@terrarium/ui-terrain",
    "build:packages": "turbo run build --filter=@terrarium/shared --filter=@terrarium/persistence --filter=@terrarium/lm-providers",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "pnpm build:packages && turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
